{
  "name": "OneTab Móvil",
  "short_name": "OneTab",
  "description": "Gestiona desde el móvil las pestañas que guardas con OneTab Drive (Dropbox).",
  "lang": "es",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e5c63",
  "theme_color": "#0e5c63",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  },
  "shortcuts": [
    { "name": "Añadir enlace", "url": "./#anadir", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Recibidas", "url": "./#recibidas", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
